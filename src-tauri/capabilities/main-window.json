{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The only capability. Grants the main window exactly the OurFault commands it uses and nothing from core or plugins (no fs, shell, dialog, clipboard, http or opener access).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-session",
    "allow-enter-work-mode",
    "allow-leave-work-mode",
    "allow-get-workspace",
    "allow-list-drafts",
    "allow-get-draft",
    "allow-create-draft",
    "allow-save-draft",
    "allow-delete-draft",
    "allow-parse-pasted-rows",
    "allow-review-draft",
    "allow-complete-draft",
    "allow-list-recent-investigations",
    "allow-search-investigations",
    "allow-get-investigation",
    "allow-compose-distribution",
    "allow-distribute-investigation",
    "allow-export-investigation-pdf",
    "allow-export-draft-pdf",
    "allow-admin-get-configuration",
    "allow-admin-save-system",
    "allow-admin-set-system-active",
    "allow-admin-save-station",
    "allow-admin-set-station-active",
    "allow-admin-save-section",
    "allow-admin-set-section-active",
    "allow-admin-move-section",
    "allow-admin-save-mail-template",
    "allow-admin-save-publication"
  ]
}
