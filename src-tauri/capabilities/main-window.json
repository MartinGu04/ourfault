{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The only capability. Grants the main window exactly the OurFault commands it uses and nothing from core or plugins (no fs, shell, dialog, http or opener access).",
  "windows": ["main"],
  "permissions": [
    "allow-get-session",
    "allow-list-recent-investigations",
    "allow-find-investigation",
    "allow-import-workbook",
    "allow-import-demo-workbook",
    "allow-list-active-systems",
    "allow-peek-next-investigation-number",
    "allow-preview-investigation",
    "allow-create-investigation",
    "allow-compose-distribution",
    "allow-distribute-investigation",
    "allow-admin-list-systems",
    "allow-admin-save-system",
    "allow-admin-set-system-active"
  ]
}
